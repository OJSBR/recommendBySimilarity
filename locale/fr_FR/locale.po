msgid "plugins.generic.recommendBySimilarity.displayName"
msgstr "Articles similaires recommandés"

msgid "plugins.generic.recommendBySimilarity.description"
msgstr ""
"Ce module ajoute une liste d'articles similaires sur la page de résumé de "
"l'article."

msgid "plugins.generic.recommendBySimilarity.heading"
msgstr "Articles similaires"

msgid "plugins.generic.recommendBySimilarity.advancedSearchIntro"
msgstr "Vous pouvez également {$advancedSearchLink} pour cet article."

msgid "plugins.generic.recommendBySimilarity.advancedSearch"
msgstr "Lancer une recherche avancée de similarité"

msgid "plugins.generic.recommendBySimilarity.task.name"
msgstr "Actualiser les articles similaires"

msgid "plugins.generic.recommendBySimilarity.task.result"
msgstr "{$refreshed} soumission(s) actualisée(s) ; {$queued} nouvelle(s) en file d'attente."

msgid "plugins.generic.recommendBySimilarity.settings.description"
msgstr "Les articles similaires sont recherchés en arrière-plan et lus dans un cache, de sorte que la page de l'article n'exécute jamais de recherche pendant que le lecteur attend."

msgid "plugins.generic.recommendBySimilarity.settings.status.title"
msgstr "Couverture"

msgid "plugins.generic.recommendBySimilarity.settings.status.body"
msgstr "{$computed} des {$total} soumissions enregistrées ont été recherchées ; {$pending} sont encore en file d'attente."

msgid "plugins.generic.recommendBySimilarity.settings.display.title"
msgstr "Affichage"

msgid "plugins.generic.recommendBySimilarity.settings.recommendationCount"
msgstr "Articles similaires par page"

msgid "plugins.generic.recommendBySimilarity.settings.maxRecommendations"
msgstr "Nombre maximal d'articles similaires enregistrés par article"

msgid "plugins.generic.recommendBySimilarity.settings.refresh.title"
msgstr "Actualisation"

msgid "plugins.generic.recommendBySimilarity.settings.refresh.hint"
msgstr "Chaque exécution de la tâche planifiée actualise une partie de la revue, en commençant par les calculs les plus anciens, de sorte que les listes n'expirent jamais toutes en même temps."

msgid "plugins.generic.recommendBySimilarity.settings.batchSize"
msgstr "Soumissions actualisées par exécution"

msgid "plugins.generic.recommendBySimilarity.settings.maxAgeDays"
msgstr "Actualiser les listes datant de plus de (jours)"

msgid "plugins.generic.recommendBySimilarity.settings.queueLimit"
msgstr "Enregistrer au plus ce nombre de soumissions (0 = sans limite)"

msgid "plugins.generic.recommendBySimilarity.settings.htmlCacheHours"
msgstr "Conserver la section générée pendant (heures)"

msgid "plugins.generic.recommendBySimilarity.settings.computeOnDemand"
msgstr "Rechercher les articles similaires manquants pendant que le lecteur attend"

msgid "plugins.generic.recommendBySimilarity.settings.computeOnDemand.hint"
msgstr "Désactivé par défaut. Tant que l'option est désactivée, un article non encore recherché n'affiche tout simplement pas la section, et la tâche planifiée la remplit. Il n'est conseillé de l'activer que sur de petites revues."

msgid "plugins.generic.recommendBySimilarity.settings.numberRequired"
msgstr "Veuillez saisir un nombre entier."

msgid "plugins.generic.recommendBySimilarity.previous"
msgstr "Précédent"

msgid "plugins.generic.recommendBySimilarity.next"
msgstr "Suivant"

msgid "plugins.generic.recommendBySimilarity.showing"
msgstr "Affichage de {$start}-{$end} sur {$total}"
