msgid "plugins.generic.recommendBySimilarity.displayName"
msgstr "Ähnliche Artikel empfehlen"

msgid "plugins.generic.recommendBySimilarity.description"
msgstr "Dieses Plugin ergänzt eine Liste ähnlicher Artikel auf der Artikel-Abstractseite."

msgid "plugins.generic.recommendBySimilarity.heading"
msgstr "Ähnliche Artikel"

msgid "plugins.generic.recommendBySimilarity.advancedSearchIntro"
msgstr "Sie können auch {$advancedSearchLink} für diesen Artikel nutzen."

msgid "plugins.generic.recommendBySimilarity.advancedSearch"
msgstr "eine erweiterte Ähnlichkeitssuche starten"

msgid "plugins.generic.recommendBySimilarity.task.name"
msgstr "Ähnliche Artikel aktualisieren"

msgid "plugins.generic.recommendBySimilarity.task.result"
msgstr "{$refreshed} Einreichung(en) aktualisiert; {$queued} neue in der Warteschlange."

msgid "plugins.generic.recommendBySimilarity.settings.description"
msgstr "Ähnliche Artikel werden im Hintergrund gesucht und aus einem Cache gelesen, damit die Artikelseite nie eine Suche ausführt, während ein/e Leser/in wartet."

msgid "plugins.generic.recommendBySimilarity.settings.status.title"
msgstr "Abdeckung"

msgid "plugins.generic.recommendBySimilarity.settings.status.body"
msgstr "{$computed} von {$total} erfassten Einreichungen wurden durchsucht; {$pending} stehen noch in der Warteschlange."

msgid "plugins.generic.recommendBySimilarity.settings.display.title"
msgstr "Anzeige"

msgid "plugins.generic.recommendBySimilarity.settings.recommendationCount"
msgstr "Ähnliche Artikel pro Seite"

msgid "plugins.generic.recommendBySimilarity.settings.maxRecommendations"
msgstr "Maximal gespeicherte ähnliche Artikel pro Artikel"

msgid "plugins.generic.recommendBySimilarity.settings.refresh.title"
msgstr "Aktualisierung"

msgid "plugins.generic.recommendBySimilarity.settings.refresh.hint"
msgstr "Jeder Lauf der geplanten Aufgabe aktualisiert einen Teil der Zeitschrift, die am längsten nicht berechneten zuerst, sodass die Listen nie alle gleichzeitig ablaufen."

msgid "plugins.generic.recommendBySimilarity.settings.batchSize"
msgstr "Einreichungen pro Lauf"

msgid "plugins.generic.recommendBySimilarity.settings.maxAgeDays"
msgstr "Listen aktualisieren, die älter sind als (Tage)"

msgid "plugins.generic.recommendBySimilarity.settings.queueLimit"
msgstr "Höchstens so viele Einreichungen erfassen (0 = unbegrenzt)"

msgid "plugins.generic.recommendBySimilarity.settings.htmlCacheHours"
msgstr "Den erzeugten Abschnitt aufbewahren für (Stunden)"

msgid "plugins.generic.recommendBySimilarity.settings.computeOnDemand"
msgstr "Fehlende ähnliche Artikel suchen, während der/die Leser/in wartet"

msgid "plugins.generic.recommendBySimilarity.settings.computeOnDemand.hint"
msgstr "Standardmäßig aus. Solange die Option aus ist, zeigt ein noch nicht durchsuchter Artikel den Abschnitt einfach nicht an, und die geplante Aufgabe füllt ihn nach. Das Einschalten empfiehlt sich nur bei kleinen Zeitschriften."

msgid "plugins.generic.recommendBySimilarity.settings.numberRequired"
msgstr "Bitte eine ganze Zahl eingeben."
